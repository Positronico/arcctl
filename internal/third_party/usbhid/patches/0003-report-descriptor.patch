+}
+
+// ReportDescriptor returns a copy of the HID report descriptor read at
+// enumeration, or nil where the platform does not expose it (Windows).
+func (d *Device) ReportDescriptor() []byte {
+	if d.reportDescriptor == nil {
+		return nil
+	}
+	return append([]byte{}, d.reportDescriptor...)
